<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
	  <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationId>com.CompanyName.AeroLink</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Airplane.ico" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Avalonia.Android" Version="11.3.11" />
	  <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1" />
	  <PackageReference Include="Xamarin.AndroidX.Core" Version="1.12.0.2" />
	  <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.5" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AeroLink\AeroLink.csproj" AdditionalProperties="RuntimeIdentifier=;SelfContained=false" />
		<ProjectReference Include="..\AeroLink.Android.Core\AeroLink.Android.Core.csproj" />
	</ItemGroup>
</Project>
